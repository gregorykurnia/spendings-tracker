{
  "name": "spendings-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:db": "firebase emulators:exec --only firestore --project demo-spendings \"vitest run --project db\"",
    "test:e2e": "tsx scripts/e2e.ts",
    "a11y": "tsx scripts/a11y.ts",
    "seed:emulator": "tsx scripts/seed-emulator.ts",
    "ocr:try": "tsx scripts/ocr-try.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "firebase": "^12.16.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.14.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "firebase-tools": "^15.34.1",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
